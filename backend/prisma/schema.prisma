generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Direction {
  PB_TO_LIMASAWA
  LIMASAWA_TO_PB
}

enum Sex {
  Male
  Female
}

enum DiscountType {
  none
  senior
  pwd
  student
}

enum DiscountStatus {
  none
  pending
  verified
  rejected
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  payment_declined
  refund_requested
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Customer {
  id                    String         @id @default(uuid())
  firstName             String         @map("first_name")
  middleName            String?        @map("middle_name")
  lastName              String         @map("last_name")
  suffix                String?
  email                 String         @unique
  passwordHash          String         @map("password_hash")
  contactNumber         String         @map("contact_number")
  barangay              String
  cityMunicipality      String         @map("city_municipality")
  province              String
  zipCode               String         @map("zip_code")
  region                String
  // Live camera capture taken during Profile Verification (not a gallery
  // upload) — kept separate from discountIdPath so admins can compare the
  // live selfie against the uploaded ID photo.
  selfiePath            String?        @map("selfie_path")
  discountType          DiscountType   @default(none) @map("discount_type")
  discountIdPath        String?        @map("discount_id_path")
  discountStatus        DiscountStatus @default(none) @map("discount_status")
  discountVerifiedUntil DateTime?      @map("discount_verified_until")
  createdAt             DateTime       @default(now()) @map("created_at")
  bookings              Booking[]

  @@map("customers")
}

model Ferry {
  id           String     @id @default(uuid())
  name         String
  seatCapacity Int        @map("seat_capacity")
  createdAt    DateTime   @default(now()) @map("created_at")
  schedules    Schedule[]

  @@map("ferries")
}

model Schedule {
  id                String    @id @default(uuid())
  ferryId           String    @map("ferry_id")
  ferry             Ferry     @relation(fields: [ferryId], references: [id])
  direction         Direction
  departureDatetime DateTime  @map("departure_datetime")
  baseFare          Decimal   @map("base_fare") @db.Decimal(10, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  bookings          Booking[]

  @@map("schedules")
}

model Booking {
  id               String             @id @default(uuid())
  scheduleId       String             @map("schedule_id")
  schedule         Schedule           @relation(fields: [scheduleId], references: [id])
  referenceCode    String             @unique @map("reference_code")
  status           BookingStatus      @default(pending_payment)
  contactEmail     String             @map("contact_email")
  contactNumber    String             @map("contact_number")
  totalFare        Decimal            @map("total_fare") @db.Decimal(10, 2)
  receiptImagePath String?            @map("receipt_image_path")
  createdAt        DateTime           @default(now()) @map("created_at")
  passengers       BookingPassenger[]
  payment          Payment?
  // Nullable — guest checkout still doesn't require an account. Set from the
  // logged-in customer's token (if any) at booking-creation time, so "My
  // Bookings" on the dashboard can look these up without trusting anything
  // the client sends.
  customerId       String?            @map("customer_id")
  customer         Customer?          @relation(fields: [customerId], references: [id])

  @@map("bookings")
}

model BookingPassenger {
  id              String       @id @default(uuid())
  bookingId       String       @map("booking_id")
  booking         Booking      @relation(fields: [bookingId], references: [id])
  firstName       String       @map("first_name")
  middleName      String?      @map("middle_name")
  lastName        String       @map("last_name")
  suffix          String?
  sex             Sex
  nationality     String
  barangay        String
  cityMunicipality String      @map("city_municipality")
  province        String
  zipCode         String       @map("zip_code")
  country         String       @default("Philippines")
  email           String?
  contactNumber   String       @map("contact_number")
  discountType    DiscountType @default(none) @map("discount_type")
  discountIdPath  String?      @map("discount_id_path")
  fare            Decimal      @db.Decimal(10, 2)

  @@map("booking_passengers")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id])
  paymentIntentId String?
  paymentMethodId String?
  qrCodeImageUrl  String?       @db.Text
  amount          Decimal
  status          PaymentStatus @default(pending)
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}