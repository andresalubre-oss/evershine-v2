generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Direction {
  PB_TO_LIMASAWA
  LIMASAWA_TO_PB
}

// 'admin' = full Evershine staff access (everything in the dashboard).
// 'coast_guard' = restricted account for the Coast Guard coordination
// feature — read-only schedules + the shared chat only, enforced at the
// route level (requireAuth only accepts 'admin'; the schedules-read and
// chat routes use requireAdminOrCoastGuard instead). Both roles share the
// same Admin table/login/2FA flow rather than a separate account system.
enum AdminRole {
  admin
  coast_guard
}

enum Sex {
  Male
  Female
}

enum DiscountType {
  none
  senior
  pwd
  student
}

enum DiscountStatus {
  none
  pending
  verified
  rejected
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  payment_declined
  refund_requested
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  // Two-factor auth (TOTP, e.g. Google Authenticator). totpSecret is written
  // during setup but twoFactorEnabled stays false until the admin confirms
  // a code — login only demands the second factor once it's true.
  totpSecret       String?  @map("totp_secret")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
    auditLogs        AdminAuditLog[]

  // Coast Guard coordination feature. `role` defaults to 'admin' so every
  // existing row stays exactly as it was before this migration.
  // `coastGuardStation` is a free-text label ("Limasawa" / "Padre Burgos")
  // shown next to a coast_guard account's messages — irrelevant for a
  // regular admin account. `coastGuardChatLastReadAt` tracks read/unread
  // per-account server-side (not just in one browser's localStorage), so
  // the "New" badge is correct no matter which device someone checks from.
  role                     AdminRole            @default(admin)
  coastGuardStation        String?              @map("coast_guard_station")
  coastGuardChatLastReadAt DateTime?            @map("coast_guard_chat_last_read_at")
  sentCoastGuardMessages   CoastGuardMessage[]
  sentManifests            SentManifest[]

  @@map("admins")
}

model Customer {
  id                    String         @id @default(uuid())
  firstName             String         @map("first_name")
  middleName            String?        @map("middle_name")
  lastName              String         @map("last_name")
  suffix                String?
  email                 String         @unique
  passwordHash          String         @map("password_hash")
  contactNumber         String         @map("contact_number")
  barangay              String
  cityMunicipality      String         @map("city_municipality")
  province              String
  zipCode               String         @map("zip_code")
  region                String
  // Live camera capture taken during Profile Verification (not a gallery
  // upload) — kept separate from discountIdPath so admins can compare the
  // live selfie against the uploaded ID photo.
  selfiePath            String?        @map("selfie_path")
  discountType          DiscountType   @default(none) @map("discount_type")
  discountIdPath        String?        @map("discount_id_path")
  // Front and back of the ID are both required so admins can check the
  // printed expiry date, which is often only on the back of Philippine IDs.
  discountIdBackPath    String?        @map("discount_id_back_path")
  discountStatus        DiscountStatus @default(none) @map("discount_status")
  discountVerifiedUntil DateTime?      @map("discount_verified_until")
  // Confirms the registrant actually controls the inbox at the email they
  // signed up with. Doesn't block login/booking — it's a trust signal shown
  // on the account page with a resend option, not a hard gate.
  emailVerified            Boolean   @default(false) @map("email_verified")
  emailVerificationToken   String?   @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")
  createdAt             DateTime       @default(now()) @map("created_at")
  bookings              Booking[]

  @@map("customers")
}

model Ferry {
  id           String     @id @default(uuid())
  name         String
  seatCapacity Int        @map("seat_capacity")
  createdAt    DateTime   @default(now()) @map("created_at")
  schedules    Schedule[]

  @@map("ferries")
}

model Schedule {
  id                     String    @id @default(uuid())
  ferryId                String    @map("ferry_id")
  ferry                  Ferry     @relation(fields: [ferryId], references: [id])
  direction              Direction
  departureDatetime      DateTime  @map("departure_datetime")
  baseFare               Decimal   @map("base_fare") @db.Decimal(10, 2)
  // Set by the admin alongside the fare itself, at schedule creation. Stored
  // per schedule (not as a global constant) so a fare change can also carry
  // a discount change, and older schedules keep whatever rate was in effect
  // when they were created. Percent off the base fare, e.g. 20.00 = 20% off.
  seniorDiscountPercent  Decimal   @default(20.00) @map("senior_discount_percent") @db.Decimal(5, 2)
  pwdDiscountPercent     Decimal   @default(20.00) @map("pwd_discount_percent") @db.Decimal(5, 2)
  studentDiscountPercent Decimal   @default(20.00) @map("student_discount_percent") @db.Decimal(5, 2)
  createdAt              DateTime  @default(now()) @map("created_at")
  bookings               Booking[]
  sentManifests          SentManifest[]

  @@map("schedules")
}

model Booking {
  id               String             @id @default(uuid())
  scheduleId       String             @map("schedule_id")
  schedule         Schedule           @relation(fields: [scheduleId], references: [id])
  referenceCode    String             @unique @map("reference_code")
  status           BookingStatus      @default(pending_payment)
  contactEmail     String             @map("contact_email")
  contactNumber    String             @map("contact_number")
  totalFare        Decimal            @map("total_fare") @db.Decimal(10, 2)
  receiptImagePath String?            @map("receipt_image_path")
  createdAt        DateTime           @default(now()) @map("created_at")
  passengers       BookingPassenger[]
  payment          Payment?
  // Nullable — guest checkout still doesn't require an account. Set from the
  // logged-in customer's token (if any) at booking-creation time, so "My
  // Bookings" on the dashboard can look these up without trusting anything
  // the client sends.
  customerId       String?            @map("customer_id")
  customer         Customer?          @relation(fields: [customerId], references: [id])

  // Refunds are reviewed and sent manually by an admin (no automated payout
  // integration) — these just record the customer's stated reason and when
  // an admin confirmed the money was actually sent.
  cancellationReason String?          @map("cancellation_reason")
  refundedAt         DateTime?        @map("refunded_at")

  @@map("bookings")
}

model BookingPassenger {
  id              String       @id @default(uuid())
  bookingId       String       @map("booking_id")
  booking         Booking      @relation(fields: [bookingId], references: [id])
  firstName       String       @map("first_name")
  middleName      String?      @map("middle_name")
  lastName        String       @map("last_name")
  suffix          String?
  sex             Sex
  nationality     String
  barangay        String
  cityMunicipality String      @map("city_municipality")
  province        String
  zipCode         String       @map("zip_code")
  country         String       @default("Philippines")
  email           String?
  contactNumber   String       @map("contact_number")
  discountType    DiscountType @default(none) @map("discount_type")
  discountIdPath  String?      @map("discount_id_path")
  fare            Decimal      @db.Decimal(10, 2)

  @@map("booking_passengers")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id])
  paymentIntentId String?
  paymentMethodId String?
  qrCodeImageUrl  String?       @db.Text
  amount          Decimal
  status          PaymentStatus @default(pending)
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

// Guest checkout has no account, so there's nothing persistent to mark
// "verified" the way Customer.emailVerified works. Instead this holds a
// short-lived one-time code sent to whatever email a guest enters at
// checkout, proving they actually control that inbox before a booking under
// it is allowed to go through. Rows are effectively disposable — expired or
// used ones just accumulate until cleaned up; there's no need to keep them
// long-term.
model GuestEmailVerification {
  id        String   @id @default(uuid())
  email     String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("guest_email_verifications")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String?  @map("admin_id")
  admin     Admin?   @relation(fields: [adminId], references: [id])
  email     String
  event     String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_audit_logs")
}

// One shared channel — every admin and every Coast Guard account (both
// stations) reads and writes the same thread, distinguished per-message by
// senderName/senderRole/senderStation. Those three are snapshotted at send
// time (not just joined live from Admin) so a message still reads sensibly
// even if the sender's name or station is edited, or the account removed,
// later.
model CoastGuardMessage {
  id            String    @id @default(uuid())
  senderId      String    @map("sender_id")
  sender        Admin     @relation(fields: [senderId], references: [id])
  senderName    String    @map("sender_name")
  senderRole    AdminRole @map("sender_role")
  senderStation String?   @map("sender_station")
  body          String
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("coast_guard_messages")
}

// A record of "Send Manifest" from the admin's Manifest tab — not the PDF
// itself (that's regenerated on demand from current passenger data whenever
// someone opens it, so it never goes stale relative to later bookings/
// cancellations for that sailing), just who it was sent to and when. Lets
// the Coast Guard portal show "manifests shared with you" instead of relying
// entirely on the account's actual email inbox, which the portal has no way
// to read. recipientAccountIds is a plain Postgres array (no join table
// needed) — the Coast Guard portal queries with a `has` filter for its own
// account id.
model SentManifest {
  id                  String   @id @default(uuid())
  scheduleId          String   @map("schedule_id")
  schedule            Schedule @relation(fields: [scheduleId], references: [id])
  sentByAdminId        String   @map("sent_by_admin_id")
  sentByAdmin          Admin    @relation(fields: [sentByAdminId], references: [id])
  recipientAccountIds String[] @map("recipient_account_ids")
  extraEmail          String?  @map("extra_email")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sent_manifests")
}